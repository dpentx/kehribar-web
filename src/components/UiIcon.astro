---
// One UI arayüzünün kendi çizgi ikonları (24x24, 2px çizgi, yuvarlak uçlar).
// Marka ikonları (GitHub vb.) için Icon.astro (Font Awesome yolları) kullanılmaya devam eder.
interface Props {
  name: keyof typeof paths;
  class?: string;
  hidden?: boolean;
}

const paths = {
  home: '<path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4v-5H9v5H5a1 1 0 0 1-1-1z"/>',
  article: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="m8 10 3 2.5L8 15M13 15h3.5"/>',
  layers: '<path d="m12 4 8 4-8 4-8-4z"/><path d="m4 12 8 4 8-4M4 16l8 4 8-4"/>',
  merge: '<circle cx="7" cy="6" r="2.2"/><circle cx="7" cy="18" r="2.2"/><circle cx="17" cy="12" r="2.2"/><path d="M7 8.2v7.6M7 8.2c0 3 2 3.8 7.8 3.8"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="3"/><path d="m5 8 7 5 7-5"/>',
  chev: '<path d="m9 6 6 6-6 6"/>',
  back: '<path d="m15 6-6 6 6 6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  star: '<path d="m12 4 2.5 5.2 5.7.8-4.1 4 1 5.6L12 17l-5.1 2.6 1-5.6-4.1-4 5.7-.8z"/>',
  music: '<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
  puzzle: '<path d="M9.5 4.5a2 2 0 1 1 4 0V6H17a1 1 0 0 1 1 1v3.5h-1.5a2 2 0 1 0 0 4H18V18a1 1 0 0 1-1 1h-3.5v-1.5a2 2 0 1 0-4 0V19H6a1 1 0 0 1-1-1v-3.5h1.5a2 2 0 1 0 0-4H5V7a1 1 0 0 1 1-1h3.5z"/>',
  rss: '<path d="M5 12a7 7 0 0 1 7 7M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1.4"/>',
} as const;

const { name, class: className, hidden } = Astro.props;
---

<svg
  class:list={['ico', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  hidden={hidden}
  set:html={paths[name]}
/>

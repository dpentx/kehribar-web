---
import Layout from '../layouts/Layout.astro';
import UiIcon from '../components/UiIcon.astro';
import { fetchGithubStats, fetchMostActiveRepo, attachRepoDescriptions } from '../lib/github';
import { loadNow, nowText } from '../lib/now';
import { loadContributions } from '../lib/contributions';
import { getCollection } from 'astro:content';
import { langPath } from '../lib/i18n';
import { fmtDate, langColor } from '../lib/ui';
import ContribTile from '../components/ContribTile.astro';

const lang = 'tr' as const;

const [stats, blogAll, now, contributions, activeRepo] = await Promise.all([
    fetchGithubStats(),
    getCollection('blog'),
    loadNow(),
    loadContributions(),
    fetchMostActiveRepo(),
]);

const posts = blogAll
    .filter((p) => p.id.startsWith(`${lang}/`))
    .map((p) => ({
        slug: p.id.slice(lang.length + 1).replace(/\.md$/, ''),
        title: p.data.title ?? p.id.split('/').pop()?.replace(/\.md$/, '') ?? p.id,
        date: p.data.date,
        description: p.data.description,
    }))
    .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
const recentPosts = posts.slice(0, 3);

const featuredRepos = await attachRepoDescriptions(
    stats.repos
        .filter((r) => !r.fork)
        .sort((a, b) => b.stargazers_count - a.stargazers_count)
        .slice(0, 4),
    lang,
);

const recentContributions = contributions.slice(0, 3);

const nixCode = `{
  <span class="key">name</span> = <span class="str">"kehribar"</span>;
  <span class="key">os</span> = <span class="str">"NixOS"</span>;
  <span class="key">compositor</span> = <span class="str">"niri"</span>;
  <span class="key">translates</span> = [ <span class="str">"en"</span> <span class="str">"tr"</span> ];
}<span class="nix-cursor"></span>`;
---

<Layout title="Kehribar — dpentx" lang={lang} activePage="home">
    <section class="viewing">
        <h1>NixOS kullanan, çeviri yapan biri.</h1>
        <p class="bio">Açık kaynak projelere katkı sağlıyorum, masaüstümü fazlasıyla özelleştiriyorum ve boş zamanlarımda İngilizce'den Türkçe'ye çeviri yapıyorum. Buraya işletim sistemleri, yapılandırma notları ve öğrendiklerimi yazıyorum.</p>
    </section>

    <div class="chips">
        {activeRepo ? (
            <a class="chip now" href={activeRepo.url} target="_blank" rel="noopener noreferrer"><span class="dot"></span>şu an uğraşılan proje: <strong>{activeRepo.name}</strong></a>
        ) : (
            <span class="chip now wrap"><span class="dot"></span><span><b>şu an:</b> {nowText(now, lang)}</span></span>
        )}
        {posts.length > 0 && <span class="chip"><b class="num">{posts.length}</b> blog yazısı</span>}
        {stats.repoCount > 0 && <span class="chip"><b class="num">{stats.repoCount}</b> repo</span>}
        {stats.starCount > 0 && <span class="chip"><b class="num">{stats.starCount}</b> yıldız</span>}
    </div>

    <div class="stack">
        <section class="widget" aria-labelledby="np-h">
            <h2 class="widget-title" id="np-h"><UiIcon name="music" />şu an dinliyor</h2>
            <img src="/api/lastfm" alt="last.fm now playing" class="lastfm" width="380" height="80" loading="lazy" />
        </section>
        <div class="nix-block" set:html={nixCode}></div>
    </div>

    <!-- son yazılar -->
    <section class="section">
        <div class="section-head">
            <h2>son yazılar</h2>
            <a class="pill-link" href={langPath(lang, '/blog')}>tümü<UiIcon name="chev" /></a>
        </div>

        {recentPosts.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="article" /></span><p>Henüz blog yazısı yok — yakında gelecek.</p></div>
            </div>
        ) : (
            <div class="group">
                {recentPosts.map((post) => (
                    <a href={langPath(lang, `/blog/${post.slug}`)} class="row">
                        <div>
                            <div class="row-title">{post.title}</div>
                            {post.description && <div class="row-desc">{post.description}</div>}
                        </div>
                        <div class="trail"><span>{fmtDate(post.date, lang)}</span><UiIcon name="chev" class="chev" /></div>
                    </a>
                ))}
            </div>
        )}
    </section>

    <!-- öne çıkan projeler -->
    {featuredRepos.length > 0 && (
        <section class="section">
            <div class="section-head">
                <h2>öne çıkan projeler</h2>
                <a class="pill-link" href={langPath(lang, '/projects')}>tümü<UiIcon name="chev" /></a>
            </div>

            <div class="group">
                {featuredRepos.map((repo) => (
                    <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="row">
                        <div>
                            <div class="row-title">{repo.name}</div>
                            {(repo.customDesc || repo.description) && <div class="row-desc">{repo.customDesc || repo.description}</div>}
                        </div>
                        <div class="trail">
                            {repo.language && <span class="lang"><i style={`--c:${langColor(repo.language)}`}></i>{repo.language}</span>}
                            {repo.stargazers_count > 0 && <span class="stars"><UiIcon name="star" /><span>{repo.stargazers_count}</span></span>}
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    <!-- son katkılar -->
    {recentContributions.length > 0 && (
        <section class="section">
            <div class="section-head">
                <h2>son katkılar</h2>
                <a class="pill-link" href={langPath(lang, '/contributions')}>tümü<UiIcon name="chev" /></a>
            </div>

            <div class="group">
                {recentContributions.map((entry) => {
                    const desc = entry.desc || entry.desc_en;
                    return (
                        <a class="row lead" href={entry.url || '#'} target="_blank" rel="noopener noreferrer">
                            <ContribTile icon={entry.icon} name={entry._name} />
                            <div>
                                <div class="row-title">{entry._name}</div>
                                {desc && <div class="row-desc">{desc}</div>}
                            </div>
                            <span class="badge">TR</span>
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <footer class="home-footer">
        <p class="label">ziyaretçi sayacı</p>
        <img
            class="counter"
            src="https://count.getloli.com/@dpentx?name=everforest&theme=rule34&padding=7&offset=0&align=top&scale=1&pixelated=1&darkmode=1"
            alt="ziyaretçi sayısı"
            loading="lazy"
            width="140"
            height="35"
        >
    </footer>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import UiIcon from '../../components/UiIcon.astro';
import ContribTile from '../../components/ContribTile.astro';
import { loadContributions } from '../../lib/contributions';

const lang = 'tr' as const;

const entries = await loadContributions();
---

<Layout title="Katkılar — Kehribar" lang={lang} activePage="contributions">
    <section class="viewing compact">
        <h1>Açık Kaynak Çeviri Katkıları</h1>
        <p class="bio">Açık kaynak ekosistemine İngilizceden Türkçeye çeviri katkıları yapıyorum.</p>
    </section>

    <div class="section first">
        {entries.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="merge" /></span><p>İçerik bulunamadı.</p></div>
            </div>
        ) : (
            <div class="group">
                {entries.map((entry) => {
                    const desc = entry.desc || entry.desc_en;
                    return (
                        <a class="row lead" href={entry.url || '#'} target="_blank" rel="noopener noreferrer">
                            <ContribTile icon={entry.icon} name={entry._name} />
                            <div>
                                <div class="row-title">{entry._name}</div>
                                {desc && <div class="row-desc">{desc}</div>}
                            </div>
                            {entry.type === 'translation' ? <span class="badge">TR</span> : <span></span>}
                        </a>
                    );
                })}
            </div>
        )}
    </div>
</Layout>

---
import Layout from '../../../layouts/Layout.astro';
import UiIcon from '../../../components/UiIcon.astro';
import { fetchGithubStats, attachRepoDescriptions } from '../../../lib/github';
import { langColor } from '../../../lib/ui';

const lang = 'en' as const;

const stats = await fetchGithubStats();
const nonForkRepos = stats.repos.filter((r) => !r.fork).sort((a, b) => b.stargazers_count - a.stargazers_count);
const repos = await attachRepoDescriptions(nonForkRepos, lang);
---

<Layout title="Projects — Kehribar" lang={lang} activePage="projects">
    <section class="viewing compact">
        <h1>Projects</h1>
    </section>

    <div class="section first">
        {repos.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="layers" /></span><p>No content found.</p></div>
            </div>
        ) : (
            <div class="group">
                {repos.map((repo) => {
                    const desc = repo.customDesc || repo.description;
                    return (
                        <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="row">
                            <div>
                                <div class="row-title">{repo.name}</div>
                                {desc && <div class="row-desc">{desc}</div>}
                            </div>
                            <div class="trail">
                                {repo.language && <span class="lang"><i style={`--c:${langColor(repo.language)}`}></i>{repo.language}</span>}
                                {repo.stargazers_count > 0 && <span class="stars"><UiIcon name="star" /><span>{repo.stargazers_count}</span></span>}
                            </div>
                        </a>
                    );
                })}
            </div>
        )}
    </div>
</Layout>

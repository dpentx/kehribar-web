---
import Layout from '../../../layouts/Layout.astro';
import UiIcon from '../../../components/UiIcon.astro';
import { getCollection } from 'astro:content';
import { langPath } from '../../../lib/i18n';
import { fmtDate } from '../../../lib/ui';

const lang = 'en' as const;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.id.startsWith(`${lang}/`))
  .map((p) => ({
    slug: p.id.slice(lang.length + 1).replace(/\.md$/, ''),
    title: p.data.title ?? p.id.split('/').pop()?.replace(/\.md$/, '') ?? p.id,
    date: p.data.date,
    description: p.data.description,
  }))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
---

<Layout title="Blog — Kehribar" lang={lang} activePage="blog">
    <section class="viewing compact">
        <div class="viewing-row">
            <h1>Blog</h1>
            <a class="pill-link" href={langPath(lang, '/rss.xml')}>RSS<UiIcon name="rss" /></a>
        </div>
    </section>

    <div class="section first">
        {posts.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="article" /></span><p>No blog posts yet — coming soon.</p></div>
            </div>
        ) : (
            <>
                <div class="search">
                    <UiIcon name="search" class="si" />
                    <input type="search" id="blog-search" placeholder="Search posts..." aria-label="Search posts..." autocomplete="off">
                    <button class="icon-btn clear" id="blog-search-clear" type="button" aria-label="clear" hidden><UiIcon name="x" /></button>
                </div>
                <div class="group" id="blog-list">
                    {posts.map((post) => (
                        <a href={langPath(lang, `/blog/${post.slug}`)} class="row" data-search={post.title.toLocaleLowerCase()}>
                            <div>
                                <div class="row-title">{post.title}</div>
                                {post.description && <div class="row-desc">{post.description}</div>}
                            </div>
                            <div class="trail"><span>{fmtDate(post.date, lang)}</span><UiIcon name="chev" class="chev" /></div>
                        </a>
                    ))}
                </div>
                <div class="group" id="blog-no-result" hidden><div class="empty-state"><p><strong>No results</strong><br>Try a different search term.</p></div></div>
            </>
        )}
    </div>

    <script>
        document.addEventListener('astro:page-load', () => {
            const input = document.getElementById('blog-search') as HTMLInputElement | null;
            const clearBtn = document.getElementById('blog-search-clear');
            const noResult = document.getElementById('blog-no-result');
            const items = document.querySelectorAll('#blog-list .row');
            if (!input) return;

            function applyFilter() {
                const q = (input?.value ?? '').trim().toLocaleLowerCase();
                let shown = 0;
                items.forEach((el) => {
                    const match = (el.getAttribute('data-search') ?? '').includes(q);
                    (el as HTMLElement).hidden = !match;
                    if (match) shown++;
                });
                if (noResult) noResult.hidden = shown !== 0;
                if (clearBtn) clearBtn.hidden = q === '';
            }
            input.addEventListener('input', applyFilter);
            clearBtn?.addEventListener('click', () => { input.value = ''; applyFilter(); input.focus(); });
        });
    </script>
</Layout>

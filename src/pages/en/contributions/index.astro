---
import Layout from '../../../layouts/Layout.astro';
import UiIcon from '../../../components/UiIcon.astro';
import ContribTile from '../../../components/ContribTile.astro';
import { loadContributions } from '../../../lib/contributions';

const lang = 'en' as const;

const entries = await loadContributions();
---

<Layout title="Contributions — Kehribar" lang={lang} activePage="contributions">
    <section class="viewing compact">
        <h1>Open Source Translation Contributions</h1>
        <p class="bio">I contribute to the open-source ecosystem through English → Turkish translations.</p>
    </section>

    <div class="section first">
        {entries.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="merge" /></span><p>No content found.</p></div>
            </div>
        ) : (
            <div class="group">
                {entries.map((entry) => {
                    const desc = entry.desc_en || entry.desc;
                    return (
                        <a class="row lead" href={entry.url || '#'} target="_blank" rel="noopener noreferrer">
                            <ContribTile icon={entry.icon} name={entry._name} />
                            <div>
                                <div class="row-title">{entry._name}</div>
                                {desc && <div class="row-desc">{desc}</div>}
                            </div>
                            <span class="badge">TR</span>
                        </a>
                    );
                })}
            </div>
        )}
    </div>
</Layout>

---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import UiIcon from '../../../components/UiIcon.astro';

const lang = 'en' as const;
---

<Layout title="Contact — Kehribar" lang={lang} activePage="contact">
    <section class="viewing compact">
        <h1>Contact</h1>
        <p class="bio">You can reach me through the following platforms.</p>
    </section>

    <div class="section first">
        <div class="group">
            <a href="https://github.com/dpentx" target="_blank" rel="noopener noreferrer" class="row lead">
                <span class="tile"><Icon name="github" class="icon" /></span>
                <div>
                    <div class="row-title">GitHub</div>
                    <div class="row-desc">My open source projects and contributions</div>
                </div>
                <UiIcon name="chev" class="chev" />
            </a>
            <a href="https://myanimelist.net/profile/dpenx" target="_blank" rel="noopener noreferrer" class="row lead">
                <span class="tile"><Icon name="book" class="icon" /></span>
                <div>
                    <div class="row-title">MyAnimeList</div>
                    <div class="row-desc">My anime watchlist and reviews</div>
                </div>
                <UiIcon name="chev" class="chev" />
            </a>
        </div>

        <div class="callout">
            <Icon name="handshake" class="icon" />
            <div>
                <strong>Open source contributions</strong>
                <p>I'm happy to contribute to open source projects and collaborate. You can reach me via GitHub and contribute to my projects.</p>
            </div>
        </div>
    </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import UiIcon from '../../components/UiIcon.astro';
import { fetchGithubStats, fetchMostActiveRepo, attachRepoDescriptions } from '../../lib/github';
import { loadNow, nowText } from '../../lib/now';
import { loadContributions } from '../../lib/contributions';
import { getCollection } from 'astro:content';
import { langPath } from '../../lib/i18n';
import { fmtDate, langColor } from '../../lib/ui';
import ContribTile from '../../components/ContribTile.astro';

const lang = 'en' as const;

const [stats, blogAll, now, contributions, activeRepo] = await Promise.all([
    fetchGithubStats(),
    getCollection('blog'),
    loadNow(),
    loadContributions(),
    fetchMostActiveRepo(),
]);

const posts = blogAll
    .filter((p) => p.id.startsWith(`${lang}/`))
    .map((p) => ({
        slug: p.id.slice(lang.length + 1).replace(/\.md$/, ''),
        title: p.data.title ?? p.id.split('/').pop()?.replace(/\.md$/, '') ?? p.id,
        date: p.data.date,
        description: p.data.description,
    }))
    .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
const recentPosts = posts.slice(0, 3);

const featuredRepos = await attachRepoDescriptions(
    stats.repos
        .filter((r) => !r.fork)
        .sort((a, b) => b.stargazers_count - a.stargazers_count)
        .slice(0, 4),
    lang,
);

const recentContributions = contributions.slice(0, 3);

const nixCode = `{
  <span class="key">name</span> = <span class="str">"kehribar"</span>;
  <span class="key">os</span> = <span class="str">"NixOS"</span>;
  <span class="key">compositor</span> = <span class="str">"niri"</span>;
  <span class="key">translates</span> = [ <span class="str">"en"</span> <span class="str">"tr"</span> ];
}<span class="nix-cursor"></span>`;
---

<Layout title="Kehribar — dpentx" lang={lang} activePage="home">
    <section class="viewing">
        <h1>NixOS user, occasional translator.</h1>
        <p class="bio">I contribute to open source projects, over-customize my desktop, and translate English to Turkish in my spare time. This is where I write about operating systems, configuration notes, and the things I learn along the way.</p>
    </section>

    <div class="chips">
        {activeRepo ? (
            <a class="chip now" href={activeRepo.url} target="_blank" rel="noopener noreferrer"><span class="dot"></span>currently working on: <strong>{activeRepo.name}</strong></a>
        ) : (
            <span class="chip now wrap"><span class="dot"></span><span><b>currently:</b> {nowText(now, lang)}</span></span>
        )}
        {posts.length > 0 && <span class="chip"><b class="num">{posts.length}</b> blog posts</span>}
        {stats.repoCount > 0 && <span class="chip"><b class="num">{stats.repoCount}</b> repos</span>}
        {stats.starCount > 0 && <span class="chip"><b class="num">{stats.starCount}</b> stars</span>}
    </div>

    <div class="stack">
        <img src="/api/lastfm?lang=en" data-card="/api/lastfm" data-lang="en" alt="last.fm" class="lastfm" width="380" height="80" />
        <div class="nix-block" set:html={nixCode}></div>
    </div>

    <!-- recent posts -->
    <section class="section">
        <div class="section-head">
            <h2>recent posts</h2>
            <a class="pill-link" href={langPath(lang, '/blog')}>all<UiIcon name="chev" /></a>
        </div>

        {recentPosts.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="article" /></span><p>No blog posts yet — coming soon.</p></div>
            </div>
        ) : (
            <div class="group">
                {recentPosts.map((post) => (
                    <a href={langPath(lang, `/blog/${post.slug}`)} class="row">
                        <div>
                            <div class="row-title">{post.title}</div>
                            {post.description && <div class="row-desc">{post.description}</div>}
                        </div>
                        <div class="trail"><span>{fmtDate(post.date, lang)}</span><UiIcon name="chev" class="chev" /></div>
                    </a>
                ))}
            </div>
        )}
    </section>

    <!-- featured projects -->
    {featuredRepos.length > 0 && (
        <section class="section">
            <div class="section-head">
                <h2>featured projects</h2>
                <a class="pill-link" href={langPath(lang, '/projects')}>all<UiIcon name="chev" /></a>
            </div>

            <div class="group">
                {featuredRepos.map((repo) => (
                    <a href={repo.html_url} target="_blank" rel="noopener noreferrer" class="row">
                        <div>
                            <div class="row-title">{repo.name}</div>
                            {(repo.customDesc || repo.description) && <div class="row-desc">{repo.customDesc || repo.description}</div>}
                        </div>
                        <div class="trail">
                            {repo.language && <span class="lang"><i style={`--c:${langColor(repo.language)}`}></i>{repo.language}</span>}
                            {repo.stargazers_count > 0 && <span class="stars"><UiIcon name="star" /><span>{repo.stargazers_count}</span></span>}
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )}

    <!-- recent contributions -->
    {recentContributions.length > 0 && (
        <section class="section">
            <div class="section-head">
                <h2>recent contributions</h2>
                <a class="pill-link" href={langPath(lang, '/contributions')}>all<UiIcon name="chev" /></a>
            </div>

            <div class="group">
                {recentContributions.map((entry) => {
                    const desc = entry.desc_en || entry.desc;
                    return (
                        <a class="row lead" href={entry.url || '#'} target="_blank" rel="noopener noreferrer">
                            <ContribTile icon={entry.icon} name={entry._name} />
                            <div>
                                <div class="row-title">{entry._name}</div>
                                {desc && <div class="row-desc">{desc}</div>}
                            </div>
                            {entry.type === 'translation' ? <span class="badge">TR</span> : <span></span>}
                        </a>
                    );
                })}
            </div>
        </section>
    )}

    <footer class="home-footer">
        <p class="label">visitor counter</p>
        <img
            class="counter"
            src="https://count.getloli.com/@dpentx?name=everforest&theme=rule34&padding=7&offset=0&align=top&scale=1&pixelated=1&darkmode=1"
            alt="visitor count"
            loading="lazy"
            width="140"
            height="35"
        >
    </footer>

    <script>
        // Kartlar <img> olarak yüklenir, bu yüzden sayfanın temasını göremezler.
        // Sitenin (veya sistemin) temasını ve dilini adres parametresi olarak iletiriz.
        function syncCards() {
            const root = document.documentElement;
            const forced = root.getAttribute('data-theme');
            const dark = forced ? forced === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.querySelectorAll<HTMLImageElement>('img[data-card]').forEach((img) => {
                const url = new URL(img.dataset.card!, location.origin);
                if (img.dataset.lang) url.searchParams.set('lang', img.dataset.lang);
                url.searchParams.set('theme', dark ? 'dark' : 'light');
                const next = url.pathname + url.search;
                if (img.getAttribute('src') !== next) img.setAttribute('src', next);
            });
        }
        document.addEventListener('astro:page-load', syncCards);
        const w = window as unknown as { __cardThemeWatch?: boolean };
        if (!w.__cardThemeWatch) {
            w.__cardThemeWatch = true;
            new MutationObserver(syncCards).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncCards);
        }
    </script>
</Layout>

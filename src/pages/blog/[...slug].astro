---
import Layout from '../../layouts/Layout.astro';
import UiIcon from '../../components/UiIcon.astro';
import { getCollection, render } from 'astro:content';
import { translations, langPath } from '../../lib/i18n';

const lang = 'tr' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.id.startsWith('tr/'));
  return posts.map((post) => ({
    params: { slug: post.id.slice('tr/'.length).replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const dict = translations[lang];
const { Content } = await render(post);
const title = post.data.title ?? post.id.split('/').pop()?.replace(/\.md$/, '') ?? post.id;
---

<Layout title={`${title} - Kehribar`} description={post.data.description} lang={lang} activePage="blog">
    <a href={langPath(lang, '/blog')} class="back">
        <UiIcon name="back" />{dict['back']}
    </a>
    <article class="markdown-content">
        <h1>{title}</h1>
        <Content />
    </article>
</Layout>

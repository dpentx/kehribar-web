---
import Layout from '../../layouts/Layout.astro';
import UiIcon from '../../components/UiIcon.astro';
import { getCollection } from 'astro:content';
import { langPath } from '../../lib/i18n';
import { fmtDate } from '../../lib/ui';

const lang = 'tr' as const;

const allPosts = await getCollection('nixzone');
const posts = allPosts
  .filter((p) => p.id.startsWith(`${lang}/`))
  .map((p) => ({
    slug: p.id.slice(lang.length + 1).replace(/\.md$/, ''),
    title: p.data.title ?? p.id.split('/').pop()?.replace(/\.md$/, '') ?? p.id,
    date: p.data.date,
  }))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
---

<Layout title="NixZONE — Kehribar" lang={lang} activePage="nixzone">
    <section class="viewing compact">
        <h1>NixZONE</h1>
        <p class="bio">Kurulum detayları, masaüstü rice'ları ve konfigürasyon notları.</p>
    </section>

    <section class="section first">
        <div class="section-head">
            <h2>yazılar</h2>
        </div>

        {posts.length === 0 ? (
            <div class="group">
                <div class="empty-state"><span class="tile"><UiIcon name="terminal" /></span><p>Henüz yazı yok — yakında gelecek.</p></div>
            </div>
        ) : (
            <>
                <div class="search">
                    <UiIcon name="search" class="si" />
                    <input type="search" id="nix-search" placeholder="Yazı ara..." aria-label="Yazı ara..." autocomplete="off">
                    <button class="icon-btn clear" id="nix-search-clear" type="button" aria-label="clear" hidden><UiIcon name="x" /></button>
                </div>
                <div class="group" id="nixzone-list">
                    {posts.map((post) => (
                        <a href={langPath(lang, `/nixzone/${post.slug}`)} class="row" data-search={post.title.toLocaleLowerCase()}>
                            <div>
                                <div class="row-title">{post.title}</div>
                            </div>
                            <div class="trail"><span>{fmtDate(post.date, lang)}</span><UiIcon name="chev" class="chev" /></div>
                        </a>
                    ))}
                </div>
                <div class="group" id="nix-no-result" hidden><div class="empty-state"><p><strong>Sonuç bulunamadı</strong><br>Başka bir kelimeyle aramayı dene.</p></div></div>
            </>
        )}
    </section>

    <script>
        document.addEventListener('astro:page-load', () => {
            const input = document.getElementById('nix-search') as HTMLInputElement | null;
            const clearBtn = document.getElementById('nix-search-clear');
            const noResult = document.getElementById('nix-no-result');
            const items = document.querySelectorAll('#nixzone-list .row');
            if (!input) return;

            function applyFilter() {
                const q = (input?.value ?? '').trim().toLocaleLowerCase();
                let shown = 0;
                items.forEach((el) => {
                    const match = (el.getAttribute('data-search') ?? '').includes(q);
                    (el as HTMLElement).hidden = !match;
                    if (match) shown++;
                });
                if (noResult) noResult.hidden = shown !== 0;
                if (clearBtn) clearBtn.hidden = q === '';
            }
            input.addEventListener('input', applyFilter);
            clearBtn?.addEventListener('click', () => { input.value = ''; applyFilter(); input.focus(); });
        });
    </script>
</Layout>
